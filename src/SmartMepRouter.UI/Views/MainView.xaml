<Window x:Class="SmartMepRouter.UI.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartMepRouter.UI.ViewModels"
        mc:Ignorable="d"
        Title="⚡ Smart MEP Router – Auto Detour Engine"
        Width="440" Height="560" MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.App}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        FontSize="13">

  <Window.Resources>
    <!-- Scoped Theme Tokens per Rule R-A7 -->
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SmartMepRouter.UI;component/Themes/Tokens.Dark.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Standard Button Style -->
      <Style x:Key="EngineeringButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="border"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                  <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Primary}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="border" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Primary Action Button Style -->
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource EngineeringButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /> <!-- 1. Connectors -->
      <RowDefinition Height="Auto" /> <!-- 2. Obstacles -->
      <RowDefinition Height="Auto" /> <!-- 3. Preferences -->
      <RowDefinition Height="*" />    <!-- Status Log -->
      <RowDefinition Height="Auto" /> <!-- Footer -->
    </Grid.RowDefinitions>

    <!-- SECTION 1: CONNECTORS -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <Border Background="{DynamicResource Brush.Accent.Subtle}" BorderBrush="{DynamicResource Brush.Accent.Primary}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,12">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasBanner}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="{Binding Banner}" Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" />
      </Border>
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="{Binding ThemeButtonText}" Click="ToggleTheme_Click" Style="{StaticResource EngineeringButton}" Height="22" Padding="8,0" FontSize="11" AutomationProperties.Name="Toggle light or dark theme" />
        <TextBlock Text="1  CONNECTORS" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
      </DockPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <Button x:Name="PickStartButton" Content="Pick Start Connector" Style="{StaticResource EngineeringButton}" Click="PickStart_Click" IsEnabled="{Binding CanPick}" AutomationProperties.Name="Pick start connector" />
          <TextBlock Text="{Binding StartConnectorText}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="2,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Button x:Name="PickEndButton" Content="Pick End Connector" Style="{StaticResource EngineeringButton}" Click="PickEnd_Click" IsEnabled="{Binding CanPick}" AutomationProperties.Name="Pick end connector" />
          <TextBlock Text="{Binding EndConnectorText}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="2,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
      <Separator Margin="0,12,0,0" Background="{DynamicResource Brush.Border.Default}" />
    </StackPanel>

    <!-- SECTION 2: OBSTACLE FILTERING -->
    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <TextBlock Text="2  OBSTACLE FILTERING" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8" />
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CheckBox Grid.Row="0" Grid.Column="0" Content="Structural Columns" IsChecked="{Binding IncludeColumns}" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}" />
        <CheckBox Grid.Row="0" Grid.Column="1" Content="Shear / Core Walls" IsChecked="{Binding IncludeWalls}" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}" />
        <CheckBox Grid.Row="1" Grid.Column="0" Content="Structural Framing" IsChecked="{Binding IncludeFraming}" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}" />
        <CheckBox Grid.Row="1" Grid.Column="1" Content="Ceiling Grid" IsChecked="{Binding IncludeCeilings}" Margin="0,4" Foreground="{DynamicResource Brush.Text.Primary}" />
      </Grid>

      <DockPanel LastChildFill="False" Margin="0,4,0,0">
        <TextBlock Text="Clearance Margin" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBox Text="{Binding ClearanceMarginMm, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Padding="6,2" Background="{DynamicResource Brush.Surface.Default}" Foreground="{DynamicResource Brush.Text.Primary}" BorderBrush="{DynamicResource Brush.Border.Default}" />
          <TextBlock Text="mm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}" />
        </StackPanel>
      </DockPanel>
      <TextBlock Text="{Binding ClearanceError}" Foreground="{DynamicResource Brush.Status.Error}" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasClearanceError}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <Separator Margin="0,12,0,0" Background="{DynamicResource Brush.Border.Default}" />
    </StackPanel>

    <!-- SECTION 3: ROUTING GEOMETRY PREFERENCES -->
    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <TextBlock Text="3  ROUTING GEOMETRY PREFERENCES" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8" />

      <!-- Discipline Selector -->
      <DockPanel Margin="0,2,0,6">
        <TextBlock Text="Discipline" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <RadioButton Content="Duct" IsChecked="{Binding IsDuctDiscipline}" GroupName="DisciplineGroup" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,10,0" />
          <RadioButton Content="Pipe" IsChecked="{Binding IsPipeDiscipline}" GroupName="DisciplineGroup" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,10,0" />
          <RadioButton Content="Cable Tray" IsChecked="{Binding IsCableTrayDiscipline}" GroupName="DisciplineGroup" Foreground="{DynamicResource Brush.Text.Primary}" />
        </StackPanel>
      </DockPanel>

      <DockPanel Margin="0,2,0,6">
        <TextBlock Text="Duct / Profile Shape" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <RadioButton Content="Rectangular" IsChecked="{Binding IsRectangular}" GroupName="DuctShape" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,12,0" />
          <RadioButton Content="Round" IsChecked="{Binding IsRound}" GroupName="DuctShape" Foreground="{DynamicResource Brush.Text.Primary}" />
        </StackPanel>
      </DockPanel>

      <DockPanel Margin="0,4,0,4">
        <TextBlock Text="Allowed Bends" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
        <ComboBox Width="180" Height="28" DockPanel.Dock="Right" SelectedValue="{Binding SelectedAllowedBends}" SelectedValuePath="Content" Background="{DynamicResource Brush.Surface.Default}" Foreground="{DynamicResource Brush.Text.Primary}">
          <ComboBoxItem Content="90° Orthogonal Only" IsSelected="True" />
          <ComboBoxItem Content="45° and 90° (FR-08)" />
        </ComboBox>
      </DockPanel>

      <DockPanel Margin="0,4,0,4">
        <TextBlock Text="Optimization" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
        <ComboBox Width="180" Height="28" DockPanel.Dock="Right" SelectedItem="{Binding SelectedOptimization}" Background="{DynamicResource Brush.Surface.Default}" Foreground="{DynamicResource Brush.Text.Primary}">
          <ComboBoxItem Content="Low Fitting Count (Fewer Bends)" IsSelected="True" />
          <ComboBoxItem Content="Shortest Length" />
        </ComboBox>
      </DockPanel>
      <Separator Margin="0,8,0,0" Background="{DynamicResource Brush.Border.Default}" />
    </StackPanel>

    <!-- STATUS LOG -->
    <GroupBox Grid.Row="3" Header="STATUS LOG" Foreground="{DynamicResource Brush.Text.Tertiary}" BorderBrush="{DynamicResource Brush.Border.Default}" Margin="0,0,0,12">
      <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
        <TextBox Text="{Binding StatusMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}" BorderThickness="0" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Margin="4" />
      </ScrollViewer>
    </GroupBox>

    <!-- FOOTER ACTIONS -->
    <Grid Grid.Row="4" Height="44">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ProgressBar VerticalAlignment="Top" Height="2" IsIndeterminate="True" BorderThickness="0" Grid.ColumnSpan="3" Foreground="{DynamicResource Brush.Accent.Primary}" Background="Transparent">
        <ProgressBar.Style>
          <Style TargetType="ProgressBar">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ProgressBar.Style>
      </ProgressBar>
      <Button Grid.Column="0" Content="{Binding PreviewButtonText}" Style="{StaticResource EngineeringButton}" Height="36" Margin="0,6,0,0" IsEnabled="{Binding CanPreview}" Click="PreviewPath_Click" IsDefault="False" AutomationProperties.Name="Preview path or cancel" />
      <Button Grid.Column="2" Content="{Binding GenerateButtonText}" Style="{StaticResource PrimaryButton}" Height="36" Margin="0,6,0,0" IsEnabled="{Binding CanGenerate}" Click="GenerateDucts_Click" AutomationProperties.Name="Generate MEP elements" />
    </Grid>
  </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Core Palette Tokens from design.md Section 3.1 -->
  <Color x:Key="BgApp">#0B0C0F</Color>
  <Color x:Key="BgTitle">#090A0D</Color>
  <Color x:Key="BgWorkspace">#0E1014</Color>
  <Color x:Key="SurfaceDefault">#14161B</Color>
  <Color x:Key="SurfaceElevated">#191C22</Color>
  <Color x:Key="SurfaceHover">#1E2229</Color>
  <Color x:Key="BorderDefault">#292D35</Color>
  <Color x:Key="BorderStrong">#363B45</Color>

  <Color x:Key="TextPrimary">#F5F7FA</Color>
  <Color x:Key="TextSecondary">#A7ADB8</Color>
  <Color x:Key="TextTertiary">#707784</Color>
  <Color x:Key="TextDisabled">#4D535E</Color>

  <Color x:Key="AccentPrimary">#8B7CFF</Color>
  <Color x:Key="AccentHover">#A397FF</Color>
  <Color x:Key="AccentSubtle">#211E3A</Color>

  <Color x:Key="StatusSuccess">#42D392</Color>
  <Color x:Key="StatusWarning">#F4B860</Color>
  <Color x:Key="StatusError">#F26D78</Color>
  <Color x:Key="StatusInfo">#5DA9FF</Color>
  <Color x:Key="BrandBolt">#F4B860</Color>

  <!-- Brush Resources -->
  <SolidColorBrush x:Key="Brush.Bg.App" Color="{StaticResource BgApp}" />
  <SolidColorBrush x:Key="Brush.Bg.Title" Color="{StaticResource BgTitle}" />
  <SolidColorBrush x:Key="Brush.Surface.Default" Color="{StaticResource SurfaceDefault}" />
  <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource SurfaceElevated}" />
  <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource SurfaceHover}" />
  <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource BorderDefault}" />
  <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource BorderStrong}" />

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource TextPrimary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource TextSecondary}" />
  <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource TextTertiary}" />
  <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource TextDisabled}" />

  <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource AccentPrimary}" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource AccentHover}" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource AccentSubtle}" />

  <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource StatusSuccess}" />
  <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource StatusWarning}" />
  <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource StatusError}" />
  <SolidColorBrush x:Key="Brush.Brand.Bolt" Color="{StaticResource BrandBolt}" />

</ResourceDictionary>

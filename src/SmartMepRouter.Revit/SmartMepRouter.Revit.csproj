<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SmartMepRouter.Revit</RootNamespace>
    <AssemblyName>SmartMepRouter.Revit</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartMepRouter.Core\SmartMepRouter.Core.csproj" />
    <ProjectReference Include="..\SmartMepRouter.UI\SmartMepRouter.UI.csproj" />
  </ItemGroup>

  <!-- .NET Framework 4.8 Reference Assemblies & Revit 2024 API -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.60" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.60" PrivateAssets="All" />
  </ItemGroup>

  <!-- Modern .NET 8 (Revit 2025-2027 API) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.4.60" PrivateAssets="All" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.60" PrivateAssets="All" />
  </ItemGroup>

  <!-- Automated Post-Build Deployment to Revit Addins per Phase 3 -->
  <Target Name="DeployToRevit" AfterTargets="Build">
    <PropertyGroup>
      <RevitVersionYear Condition="'$(TargetFramework)' == 'net8.0-windows'">2027</RevitVersionYear>
      <RevitVersionYear Condition="'$(TargetFramework)' == 'net48'">2024</RevitVersionYear>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersionYear)</RevitAddinsDir>
      <RevitAddinTargetDir>$(RevitAddinsDir)\SmartMepRouter</RevitAddinTargetDir>
    </PropertyGroup>

    <ItemGroup>
      <AddinManifest Include="$(SolutionDir)addin\SmartMepRouter.addin" />
      <BuildOutputFiles Include="$(TargetDir)*.*" />
    </ItemGroup>

    <!-- Copy .addin manifest into Revit Addins folder -->
    <Copy SourceFiles="@(AddinManifest)" DestinationFolder="$(RevitAddinsDir)" SkipUnchangedFiles="true" Condition="Exists('$(RevitAddinsDir)')" />

    <!-- Copy binary assemblies and dependencies into SmartMepRouter subfolder -->
    <Copy SourceFiles="@(BuildOutputFiles)" DestinationFolder="$(RevitAddinTargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(RevitAddinsDir)')" />
  </Target>

</Project>
